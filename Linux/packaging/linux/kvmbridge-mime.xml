<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-kvmbridge-config">
    <comment>KVM Bridge config</comment>
    <icon name="kvmbridge"/>
    <glob pattern="*.kvmb"/>
    <magic priority="80">
      <match type="string" offset="0" value="KVMBCONF"/>
    </magic>
  </mime-type>
</mime-info>
